<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
<title>Sandeep Kumar Gupta — Insurance & Financial Advisor</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
:root{
  --bg:#04080e;--s1:#070d18;--s2:#0a1120;
  --g1:#f4b942;--g2:#d4780a;--g3:#ffe48a;
  --txt:#eef0f8;--muted:rgba(238,240,248,.44);
  --ease:cubic-bezier(.16,1,.3,1);
  --spring:cubic-bezier(.34,1.56,.64,1);
  --snappy:cubic-bezier(.4,0,.2,1);
}
html{scroll-behavior:smooth;-webkit-tap-highlight-color:transparent;}
body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--txt);overflow-x:hidden;cursor:none;}
@media(pointer:coarse){body{cursor:auto;}}
::-webkit-scrollbar{width:2px;}
::-webkit-scrollbar-thumb{background:linear-gradient(var(--g2),var(--g1));}

/* ══ CURSOR (desktop only) ══ */
#cur,#cur2{position:fixed;border-radius:50%;pointer-events:none;z-index:99999;transform:translate(-50%,-50%);will-change:left,top;}
#cur{width:9px;height:9px;background:var(--g1);mix-blend-mode:difference;}
#cur2{width:30px;height:30px;border:1.5px solid rgba(244,185,66,.45);transition:width .4s var(--spring),height .4s var(--spring),border-color .3s,left .1s,top .1s;}
.cg #cur{width:50px;height:50px;}
.cg #cur2{width:70px;height:70px;border-color:rgba(244,185,66,.15);}
@media(pointer:coarse){#cur,#cur2{display:none;}}

/* ══ NETFLIX INTRO ══ */
#intro{
  position:fixed;inset:0;z-index:99900;
  background:#000;display:flex;align-items:center;justify-content:center;
  overflow:hidden;
}
.i-bg{position:absolute;inset:0;background:radial-gradient(ellipse 70% 60% at 50% 50%,rgba(200,30,10,.22) 0%,transparent 70%);animation:iBgPulse 2s ease infinite;}
@keyframes iBgPulse{0%,100%{opacity:.6;}50%{opacity:1;}}
.i-lines{position:absolute;inset:0;background:repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(0,0,0,.12) 2px,rgba(0,0,0,.12) 4px);pointer-events:none;}
.i-center{position:relative;z-index:2;text-align:center;}
.i-ring{
  width:100px;height:100px;border-radius:50%;margin:0 auto 18px;overflow:hidden;
  border:2.5px solid var(--g1);
  transform:scale(0) rotate(-180deg);opacity:0;
  animation:iRingIn .8s .3s var(--spring) forwards;
  box-shadow:0 0 0 0 rgba(244,185,66,.5);
}
.i-ring.pulse{animation:iRingIn .8s .3s var(--spring) forwards,iGlow 2s 1.2s ease infinite;}
@keyframes iRingIn{to{transform:scale(1) rotate(0deg);opacity:1;}}
@keyframes iGlow{0%,100%{box-shadow:0 0 0 0 rgba(244,185,66,.4);}50%{box-shadow:0 0 0 18px rgba(244,185,66,0);}}
.i-ring img{width:100%;height:100%;object-fit:cover;object-position:center 22%;}
.i-name{
  font-family:'Playfair Display',serif;
  font-size:clamp(1.6rem,5vw,2.8rem);font-weight:900;
  color:#fff;letter-spacing:4px;text-transform:uppercase;
  display:flex;justify-content:center;flex-wrap:wrap;gap:0 1px;
  margin-bottom:8px;
}
.i-ch{
  display:inline-block;opacity:0;transform:translateY(60%) scaleY(.4);
  animation:iChIn .5s var(--spring) forwards;
  filter:blur(4px);
}
@keyframes iChIn{to{opacity:1;transform:translateY(0) scaleY(1);filter:blur(0);}}
.i-sub{font-size:.72rem;letter-spacing:5px;text-transform:uppercase;color:rgba(255,255,255,.35);opacity:0;animation:iFade .5s 1.8s ease forwards;}
.i-line{width:160px;height:1.5px;background:rgba(255,255,255,.08);border-radius:2px;margin:22px auto 0;overflow:hidden;opacity:0;animation:iFade .3s 2s ease forwards;}
.i-prog{height:100%;background:linear-gradient(90deg,var(--g2),var(--g1),var(--g3));animation:iLoad 1.5s 2.1s var(--ease) forwards;}
@keyframes iFade{to{opacity:1;}}
@keyframes iLoad{from{width:0;}to{width:100%;}}
/* Split curtain exit */
.i-top,.i-bot{position:absolute;left:0;right:0;height:51%;background:#000;z-index:3;transition:transform 1.1s cubic-bezier(.76,0,.24,1);}
.i-top{top:0;}.i-bot{bottom:0;}
#intro.split .i-top{transform:translateY(-101%);}
#intro.split .i-bot{transform:translateY(101%);}
#intro.gone{display:none;}

/* ══ MAIN ══ */
#main{opacity:0;transform:translateY(12px);transition:opacity .9s var(--ease),transform .9s var(--ease);}
#main.in{opacity:1;transform:translateY(0);}

/* ══ NAV ══ */
nav{
  position:fixed;top:10px;left:50%;transform:translateX(-50%);z-index:9000;
  width:min(calc(100% - 28px),1160px);height:56px;padding:0 18px;
  display:flex;align-items:center;justify-content:space-between;
  border-radius:18px;
  background:rgba(7,13,26,.45);
  backdrop-filter:blur(28px) saturate(180%);-webkit-backdrop-filter:blur(28px) saturate(180%);
  border:1px solid rgba(255,255,255,.09);
  box-shadow:0 8px 32px rgba(0,0,0,.35),inset 0 1px 0 rgba(255,255,255,.07);
  transition:background .4s,box-shadow .4s;
}
nav.s{background:rgba(4,8,14,.9);box-shadow:0 16px 48px rgba(0,0,0,.6),inset 0 1px 0 rgba(255,255,255,.05);}
.nb{display:flex;align-items:center;gap:10px;text-decoration:none;flex-shrink:0;}
.nb img{width:34px;height:34px;border-radius:50%;object-fit:cover;object-position:center 22%;border:1.5px solid rgba(244,185,66,.5);animation:nbGlow 3s ease infinite;}
@keyframes nbGlow{0%,100%{box-shadow:0 0 8px rgba(244,185,66,.3);}50%{box-shadow:0 0 18px rgba(244,185,66,.65);}}
.nb-t{line-height:1.2;}
.nb-t strong{font-family:'Playfair Display',serif;font-size:.86rem;display:block;}
.nb-t small{font-size:.54rem;color:var(--muted);letter-spacing:1.5px;text-transform:uppercase;}
.nl{display:flex;gap:1px;}
.nl a{color:rgba(255,255,255,.58);text-decoration:none;font-size:.76rem;font-weight:500;padding:5px 11px;border-radius:16px;transition:all .3s;}
.nl a:hover{background:rgba(255,255,255,.08);color:#fff;}
.nacts{display:flex;gap:7px;flex-shrink:0;}
.nc{background:rgba(244,185,66,.1);border:1px solid rgba(244,185,66,.22);color:var(--g1);padding:6px 13px;border-radius:16px;text-decoration:none;font-size:.73rem;font-weight:700;transition:all .3s;white-space:nowrap;}
.nc:hover{background:rgba(244,185,66,.2);}
.nw{background:linear-gradient(135deg,#25d366,#1aad53);color:#fff;padding:6px 14px;border-radius:16px;text-decoration:none;font-size:.73rem;font-weight:700;box-shadow:0 4px 12px rgba(37,211,102,.25);transition:all .3s;white-space:nowrap;}
.nw:hover{transform:translateY(-2px);box-shadow:0 7px 20px rgba(37,211,102,.4);}

/* ══ HERO ══ */
.hero{
  min-height:100vh;min-height:100svh;
  position:relative;overflow:hidden;display:flex;align-items:center;
  background:
    radial-gradient(ellipse 55% 65% at 72% 36%,rgba(180,90,10,.22) 0%,transparent 60%),
    radial-gradient(ellipse 45% 55% at 10% 78%,rgba(14,44,110,.18) 0%,transparent 60%),
    radial-gradient(ellipse 70% 40% at 50% 0%,rgba(37,99,235,.06) 0%,transparent 70%),
    #04080e;
}
#hcvs{position:absolute;inset:0;z-index:0;}
.hi{max-width:1160px;margin:0 auto;padding:108px 40px 96px;display:grid;grid-template-columns:1fr 355px;gap:60px;align-items:center;position:relative;z-index:2;width:100%;}

.h-pill{display:inline-flex;align-items:center;gap:8px;padding:5px 15px;border-radius:30px;font-size:.65rem;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:var(--g1);margin-bottom:17px;background:rgba(244,185,66,.07);backdrop-filter:blur(10px);border:1px solid rgba(244,185,66,.2);opacity:0;animation:hUp .6s .1s var(--ease) forwards;}
.pd{width:5px;height:5px;background:var(--g1);border-radius:50%;animation:blink 1.5s infinite;}
@keyframes blink{0%,100%{opacity:1;}50%{opacity:0;}}
@keyframes hUp{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:translateY(0);}}

.hh{font-family:'Playfair Display',serif;font-size:clamp(2.3rem,3.8vw,3.9rem);font-weight:900;line-height:1.08;opacity:0;animation:hUp .75s .22s var(--ease) forwards;}
.gold{background:linear-gradient(110deg,var(--g2),var(--g1) 40%,var(--g3) 72%,var(--g1));background-size:200%;-webkit-background-clip:text;-webkit-text-fill-color:transparent;animation:shim 4s linear infinite 2.2s;}
@keyframes shim{to{background-position:-200% center;}}
.hsub{color:var(--muted);font-size:.93rem;line-height:1.82;margin-top:15px;max-width:430px;opacity:0;animation:hUp .7s .38s var(--ease) forwards;}
.hchips{display:flex;flex-wrap:wrap;gap:7px;margin-top:20px;opacity:0;animation:hUp .7s .52s var(--ease) forwards;}
.hc{display:flex;align-items:center;gap:6px;padding:7px 13px;border-radius:20px;font-size:.74rem;font-weight:500;background:rgba(255,255,255,.04);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.09);color:rgba(255,255,255,.7);cursor:pointer;transition:all .35s var(--ease);user-select:none;}
.hc:hover,.hc:active{background:rgba(244,185,66,.1);border-color:rgba(244,185,66,.3);color:var(--g1);transform:translateY(-3px);}
.hbtns{display:flex;gap:10px;flex-wrap:wrap;margin-top:26px;opacity:0;animation:hUp .7s .66s var(--ease) forwards;}
.bcall{display:inline-flex;align-items:center;gap:7px;padding:13px 24px;border-radius:13px;text-decoration:none;font-weight:700;font-size:.86rem;background:linear-gradient(135deg,var(--g2),var(--g1));color:#fff;box-shadow:0 8px 28px rgba(180,90,10,.45);transition:all .35s var(--ease);position:relative;overflow:hidden;}
.bcall::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,var(--g1),var(--g3));opacity:0;transition:opacity .35s;}
.bcall:hover::before{opacity:1;}
.bcall:hover{transform:translateY(-4px);box-shadow:0 16px 40px rgba(180,90,10,.6);}
.bcall span{position:relative;z-index:1;}
.bwa{display:inline-flex;align-items:center;gap:7px;padding:13px 24px;border-radius:13px;text-decoration:none;font-weight:600;font-size:.86rem;background:rgba(255,255,255,.05);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.11);color:#fff;transition:all .35s;}
.bwa:hover{background:rgba(255,255,255,.1);transform:translateY(-4px);}

/* hero photo */
.hphoto{position:relative;opacity:0;animation:hPhotoIn .9s .3s var(--ease) forwards;}
@keyframes hPhotoIn{from{opacity:0;transform:translateX(36px) scale(.95);}to{opacity:1;transform:translateX(0) scale(1);}}
.ra,.rb{position:absolute;border-radius:28px;pointer-events:none;}
.ra{inset:-14px;border:1px dashed rgba(244,185,66,.16);animation:spinS 28s linear infinite;}
.rb{inset:-28px;border:1px dotted rgba(244,185,66,.07);animation:spinS 44s linear infinite reverse;}
@keyframes spinS{to{transform:rotate(360deg);}}
.pf{border-radius:26px;overflow:hidden;cursor:pointer;position:relative;border:1px solid rgba(244,185,66,.16);box-shadow:0 40px 90px rgba(0,0,0,.7),0 0 50px rgba(180,90,10,.1),inset 0 1px 0 rgba(255,255,255,.05);transition:transform .5s var(--ease),box-shadow .5s;}
.pf:hover{transform:translateY(-10px);box-shadow:0 55px 110px rgba(0,0,0,.8),0 0 70px rgba(180,90,10,.18);}
.pf img{width:100%;height:390px;object-fit:cover;object-position:center 22%;transition:transform .7s var(--ease);}
.pf:hover img{transform:scale(1.05);}
.pov{position:absolute;inset:0;background:linear-gradient(to top,rgba(4,8,14,.9) 0%,rgba(4,8,14,.18) 45%,transparent 70%);}
.ptag{position:absolute;top:11px;right:11px;z-index:3;background:rgba(244,185,66,.88);backdrop-filter:blur(8px);color:#fff;padding:4px 11px;border-radius:17px;font-size:.66rem;font-weight:700;animation:bob 2.5s ease infinite;}
@keyframes bob{0%,100%{transform:translateY(0);}50%{transform:translateY(-5px);}}
.pinfo{position:absolute;bottom:11px;left:11px;right:11px;z-index:3;background:rgba(4,8,14,.7);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.1);border-radius:12px;padding:10px 13px;display:flex;align-items:center;justify-content:space-between;}
.pn{font-size:.77rem;font-weight:600;}.pn small{font-size:.6rem;color:var(--muted);display:block;}
.ps{display:flex;align-items:center;gap:5px;font-size:.62rem;color:var(--muted);}
.ps::before{content:'';width:6px;height:6px;background:#22c55e;border-radius:50%;animation:pg 2s infinite;}
@keyframes pg{0%{box-shadow:0 0 0 0 rgba(34,197,94,.5);}70%{box-shadow:0 0 0 7px transparent;}100%{box-shadow:0 0 0 0 transparent;}}

/* scroll hint */
.sh-wrap{position:absolute;bottom:28px;left:50%;transform:translateX(-50%);z-index:10;display:flex;flex-direction:column;align-items:center;gap:7px;transition:opacity .6s;}
.sh-wrap span{font-size:.62rem;letter-spacing:2.5px;text-transform:uppercase;color:var(--muted);}
.sh-mouse{width:20px;height:32px;border:1.5px solid rgba(255,255,255,.22);border-radius:11px;display:flex;justify-content:center;padding-top:6px;}
.sh-dot{width:2.5px;height:5px;background:var(--g1);border-radius:2px;animation:shScroll 1.8s ease infinite;}
@keyframes shScroll{0%{transform:translateY(0);opacity:1;}60%{transform:translateY(7px);opacity:.2;}100%{transform:translateY(0);opacity:1;}}

/* ══ TICKER ══ */
.ticker{position:relative;z-index:2;padding:13px 0;overflow:hidden;background:linear-gradient(135deg,rgba(180,90,10,.12),rgba(244,185,66,.06));border-top:1px solid rgba(244,185,66,.12);border-bottom:1px solid rgba(244,185,66,.12);}
.tt{display:flex;white-space:nowrap;animation:tk 22s linear infinite;}
@keyframes tk{to{transform:translateX(-50%);}}
.ti{display:inline-flex;align-items:center;gap:7px;padding:0 22px;font-size:.73rem;font-weight:600;color:var(--g1);letter-spacing:.3px;}
.ti::before{content:'✦';font-size:.4rem;opacity:.5;}

/* ══ STATS ══ */
.stats{background:var(--s1);padding:48px;border-bottom:1px solid rgba(255,255,255,.04);}
.sg2{max-width:1160px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);}
.st{text-align:center;padding:0 14px;border-right:1px solid rgba(255,255,255,.05);opacity:0;transform:translateY(20px);transition:all .6s var(--ease);}
.st.v{opacity:1;transform:translateY(0);}
.st:last-child{border:none;}
.sn{font-family:'Playfair Display',serif;font-size:2.6rem;font-weight:900;line-height:1;background:linear-gradient(135deg,var(--g2),var(--g1),var(--g3));-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
.sl{color:var(--muted);font-size:.67rem;margin-top:5px;letter-spacing:.5px;text-transform:uppercase;}

/* ══ SEC BASE ══ */
.sec{padding:92px 48px;position:relative;}
.si{max-width:1160px;margin:0 auto;}
.stag{font-size:.65rem;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--g1);margin-bottom:10px;display:flex;align-items:center;gap:8px;}
.stag::before{content:'';width:16px;height:1.5px;background:var(--g1);}
.sec-h{font-family:'Playfair Display',serif;font-size:clamp(1.8rem,2.7vw,2.75rem);font-weight:900;line-height:1.15;margin-bottom:13px;}
.sec-s{font-size:.91rem;line-height:1.82;color:var(--muted);max-width:480px;}
/* reveals */
.rv{opacity:0;transform:translateY(36px);transition:opacity .8s var(--ease),transform .8s var(--ease);}
.rv.v{opacity:1;transform:translateY(0);}
.rl{opacity:0;transform:translateX(-38px);transition:opacity .8s var(--ease),transform .8s var(--ease);}
.rl.v{opacity:1;transform:translateX(0);}
.rr{opacity:0;transform:translateX(38px);transition:opacity .8s var(--ease),transform .8s var(--ease);}
.rr.v{opacity:1;transform:translateX(0);}

/* ══ SERVICES ══ */
#svcs{background:linear-gradient(180deg,var(--bg) 0%,var(--s1) 100%);}
.scg{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:46px;}
.sc{
  border-radius:22px;padding:26px 20px;position:relative;overflow:hidden;cursor:pointer;
  background:rgba(255,255,255,.03);
  backdrop-filter:blur(20px) saturate(160%);-webkit-backdrop-filter:blur(20px) saturate(160%);
  border:1px solid rgba(255,255,255,.07);
  opacity:0;transform:translateY(32px) scale(.97);
  transition:opacity .7s var(--ease),transform .7s var(--ease),border-color .4s,box-shadow .4s,background .4s;
  -webkit-tap-highlight-color:transparent;
}
.sc.v{opacity:1;transform:translateY(0) scale(1);}
.sc::before{content:'';position:absolute;top:0;left:0;right:0;height:1.5px;background:linear-gradient(90deg,transparent,rgba(244,185,66,.55),transparent);opacity:0;transition:opacity .4s;}
.sc::after{content:'';position:absolute;top:0;left:-80%;width:50%;height:100%;background:linear-gradient(105deg,transparent,rgba(255,255,255,.035),transparent);transform:skewX(-15deg);transition:left .6s var(--ease);pointer-events:none;}
.sc:hover::before,.sc:active::before{opacity:1;}
.sc:hover::after{left:130%;}
.sc:hover,.sc:active{background:rgba(255,255,255,.055);border-color:rgba(244,185,66,.2);box-shadow:0 26px 65px rgba(0,0,0,.5);transform:translateY(-9px) scale(1.01) !important;}
.sc-num{font-family:'Playfair Display',serif;font-size:3.8rem;font-weight:900;color:rgba(255,255,255,.025);line-height:1;}
.sc-ic{font-size:1.85rem;display:block;margin-bottom:11px;transition:transform .4s var(--spring);}
.sc:hover .sc-ic{transform:scale(1.25) rotate(-7deg);}
.sc h3{font-size:.96rem;font-weight:700;margin-bottom:7px;}
.sc p{font-size:.79rem;line-height:1.74;color:var(--muted);}
.sc-cta{display:inline-flex;align-items:center;gap:5px;color:var(--g1);font-size:.71rem;font-weight:700;margin-top:13px;opacity:0;transform:translateX(-6px);transition:opacity .3s,transform .3s;}
.sc:hover .sc-cta,.sc:active .sc-cta{opacity:1;transform:translateX(0);}

/* ══ REVIEWS ══ */
#revs{background:radial-gradient(ellipse 55% 45% at 30% 40%,rgba(14,44,110,.13) 0%,transparent 64%),radial-gradient(ellipse 40% 55% at 80% 60%,rgba(180,90,10,.08) 0%,transparent 60%),var(--s1);}
.rcg{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:46px;}
.rc{border-radius:22px;padding:22px 18px;position:relative;overflow:hidden;background:rgba(255,255,255,.04);backdrop-filter:blur(24px) saturate(180%);-webkit-backdrop-filter:blur(24px) saturate(180%);border:1px solid rgba(255,255,255,.08);opacity:0;transform:translateY(26px);transition:opacity .7s var(--ease),transform .7s var(--ease),border-color .4s,box-shadow .4s;}
.rc.v{opacity:1;transform:translateY(0);}
.rc:hover{border-color:rgba(244,185,66,.2);box-shadow:0 22px 55px rgba(0,0,0,.4);transform:translateY(-5px);}
.rc::before{content:'"';position:absolute;top:6px;right:14px;font-family:'Playfair Display',serif;font-size:4.5rem;color:rgba(244,185,66,.06);line-height:1;pointer-events:none;}
.stars{display:flex;gap:2px;margin-bottom:9px;}
.star{color:var(--g1);font-size:.86rem;}
.rc-txt{font-size:.81rem;line-height:1.75;color:rgba(238,240,248,.66);font-style:italic;}
.rc-ft{display:flex;align-items:center;gap:9px;margin-top:14px;padding-top:12px;border-top:1px solid rgba(255,255,255,.06);}
.rc-av{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.84rem;font-weight:700;flex-shrink:0;border:1.5px solid rgba(244,185,66,.22);font-family:'Playfair Display',serif;}
.rc-name{font-size:.8rem;font-weight:700;}
.rc-role{font-size:.64rem;color:var(--muted);}
.rc-badge{margin-left:auto;background:rgba(34,197,94,.1);border:1px solid rgba(34,197,94,.2);color:#4ade80;padding:2px 7px;border-radius:9px;font-size:.59rem;font-weight:700;}

/* ══ ABOUT ══ */
#about{background:linear-gradient(180deg,var(--s1) 0%,var(--bg) 100%);}
.ag{display:grid;grid-template-columns:1fr 1fr;gap:66px;align-items:center;}
.aw{position:relative;}
.aph{border-radius:24px;overflow:hidden;border:1px solid rgba(255,255,255,.06);box-shadow:0 28px 75px rgba(0,0,0,.6);}
.aph img{width:100%;height:430px;object-fit:cover;object-position:center 22%;transition:transform .7s var(--ease);}
.aph:hover img{transform:scale(1.04);}
.afl{position:absolute;bottom:-15px;right:-15px;padding:15px 20px;border-radius:17px;text-align:center;background:linear-gradient(135deg,var(--g2),var(--g1));box-shadow:0 18px 45px rgba(180,90,10,.42);animation:floatY 4s ease infinite;}
@keyframes floatY{0%,100%{transform:translateY(0);}50%{transform:translateY(-8px);}}
.afl strong{font-family:'Playfair Display',serif;font-size:1.9rem;font-weight:900;color:#fff;display:block;line-height:1;}

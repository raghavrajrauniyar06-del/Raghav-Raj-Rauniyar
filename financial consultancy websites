/* ══════════════════════════════════════════
   SMOOTH SCROLL
══════════════════════════════════════════ */
document.querySelectorAll('a[href^="#"]').forEach(a=>{
  a.addEventListener('click',e=>{
    const t=document.querySelector(a.getAttribute('href'));
    if(t){e.preventDefault();t.scrollIntoView({behavior:'smooth',block:'start'});}
  });
});

/* ══════════════════════════════════════════
   SWIPE GESTURE (touch) — page scroll hint
══════════════════════════════════════════ */
let ts0=0,ty0=0;
document.addEventListener('touchstart',e=>{ts0=e.touches[0].clientY;},{passive:true});
document.addEventListener('touchmove',e=>{
  const dy=ts0-e.touches[0].clientY;
  if(Math.abs(dy)>30&&scrollY===0&&dy>0){
    document.getElementById('scrollHint').style.opacity='0';
  }
},{passive:true});
</script>

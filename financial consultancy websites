  const ts=new Date().toLocaleString('en-IN',{timeZone:'Asia/Kolkata'});
  const txt=`🌟 *New Website Enquiry*\n\n👤 *Name:* ${name}\n📞 *Phone:* ${phone}\n🏦 *Service:* ${svc||'Not specified'}\n📍 *City:* ${city||'Not mentioned'}\n💬 *Message:* ${msg||'No message'}\n🌐 *IP:* ${loc}\n🕐 *Time:* ${ts}\n\n_Sent from your website_`;

/* ══════════════════════════════════════════
   HERO PARALLAX (GPU only)
══════════════════════════════════════════ */
let lastY=0,ticking=false;
window.addEventListener('scroll',()=>{
  lastY=scrollY;
  if(!ticking){requestAnimationFrame(()=>{
    const hh=document.getElementById('hero').offsetHeight;
    if(lastY<hh){
      document.querySelector('.hi').style.transform=`translateY(${lastY*.22}px)`;
      document.getElementById('hcvs').style.transform=`translateY(${lastY*.38}px)`;
    }
    ticking=false;
  });ticking=true;}
},{passive:true});

/* ══════════════════════════════════════════
   HERO CANVAS ORBS
══════════════════════════════════════════ */
(()=>{
  const cv=document.getElementById('hcvs'),ctx=cv.getContext('2d');
  const sz=()=>{cv.width=cv.parentElement.offsetWidth;cv.height=cv.parentElement.offsetHeight;};sz();
  window.addEventListener('resize',sz,{passive:true});
  const o=[{x:.72,y:.34,r:230,c:'180,90,10',a:.18},{x:.12,y:.72,r:185,c:'14,44,110',a:.13},{x:.5,y:.08,r:145,c:'37,99,235',a:.08},{x:.9,y:.78,r:105,c:'180,90,10',a:.07}];
  let t=0;
  (function d(){ctx.clearRect(0,0,cv.width,cv.height);t+=.003;
    o.forEach((ob,i)=>{const x=(ob.x+Math.sin(t+i*1.2)*.025)*cv.width,y=(ob.y+Math.cos(t+i*.9)*.025)*cv.height;const g=ctx.createRadialGradient(x,y,0,x,y,ob.r);g.addColorStop(0,`rgba(${ob.c},${ob.a})`);g.addColorStop(1,'transparent');ctx.beginPath();ctx.arc(x,y,ob.r,0,Math.PI*2);ctx.fillStyle=g;ctx.fill();});
    requestAnimationFrame(d);})();
})();

/* ══════════════════════════════════════════
   FLOATING STARS CANVAS
══════════════════════════════════════════ */
(()=>{
  const cv=document.createElement('canvas');
  cv.style.cssText='position:fixed;inset:0;z-index:0;pointer-events:none;';
  document.body.appendChild(cv);
  const ctx=cv.getContext('2d');
  const sz=()=>{cv.width=innerWidth;cv.height=innerHeight;};sz();
  window.addEventListener('resize',sz,{passive:true});
  const pts=Array.from({length:70},()=>({
    x:Math.random()*innerWidth,y:Math.random()*innerHeight,
    s:Math.random()*.8+.2,vx:(Math.random()-.5)*.14,vy:(Math.random()-.5)*.14,
    a:Math.random()*.18+.04,c:Math.random()>.72?'244,185,66':'255,255,255'
  }));
  (function d(){ctx.clearRect(0,0,cv.width,cv.height);pts.forEach(p=>{p.x+=p.vx;p.y+=p.vy;if(p.x<0)p.x=cv.width;if(p.x>cv.width)p.x=0;if(p.y<0)p.y=cv.height;if(p.y>cv.height)p.y=0;ctx.beginPath();ctx.arc(p.x,p.y,p.s,0,Math.PI*2);ctx.fillStyle=`rgba(${p.c},${p.a})`;ctx.fill();});requestAnimationFrame(d);})();
})();

/* ══════════════════════════════════════════
   SCROLL REVEAL
══════════════════════════════════════════ */
const io=new IntersectionObserver(e=>e.forEach(el=>{if(el.isIntersecting)el.target.classList.add('v');}),{threshold:.1,rootMargin:'0px 0px -40px 0px'});
document.querySelectorAll('.rv,.rl,.rr,.sc,.st,.rc').forEach(el=>io.observe(el));
document.querySelectorAll('.sc').forEach((el,i)=>el.style.transitionDelay=(i*.065)+'s');
document.querySelectorAll('.rc').forEach((el,i)=>el.style.transitionDelay=(i*.07)+'s');
document.querySelectorAll('.st').forEach((el,i)=>el.style.transitionDelay=(i*.1)+'s');

/* ══════════════════════════════════════════
   COUNTERS
══════════════════════════════════════════ */
const co=new IntersectionObserver(e=>{e.forEach(el=>{if(el.isIntersecting&&el.target.dataset.c){
  const t=+el.target.dataset.c;let n=0;
  const s=setInterval(()=>{n+=Math.ceil(t/50);if(n>=t){el.target.textContent=t+'+';clearInterval(s);}else el.target.textContent=n+'+';},24);
  co.unobserve(el.target);}});},{threshold:.5});
document.querySelectorAll('.sn[data-c]').forEach(el=>co.observe(el));


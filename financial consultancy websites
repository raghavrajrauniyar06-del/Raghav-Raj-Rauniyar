function openPop(){document.getElementById('ppWrap').classList.add('open');document.body.style.overflow='hidden';}
function closePop(){document.getElementById('ppWrap').classList.remove('open');document.body.style.overflow='';}
document.getElementById('ppCloseBtn').addEventListener('click',closePop);
document.getElementById('ppWrap').addEventListener('click',e=>{if(e.target===document.getElementById('ppWrap'))closePop();});
document.addEventListener('keydown',e=>{if(e.key==='Escape'){closePop();closeSvc();}});


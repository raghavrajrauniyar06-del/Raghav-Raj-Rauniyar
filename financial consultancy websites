    notify('🌐 New Website Visitor',{
      IP:geoData.ip,
      Location:loc,
      Device:dev,
      Browser:br,
      Screen:`${screen.width}×${screen.height}`,
      Time:ts,
      Referrer:document.referrer||'Direct',
